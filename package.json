{
  "name": "aula-facil-desktop",
  "version": "0.5.0-rc.1",
  "private": true,
  "description": "Aplicativo desktop do AulaFácil para gestão escolar",
  "license": "MIT",
  "author": "kuadmff2-bit",
  "homepage": "https://github.com/kuadmff2-bit/aula-facil#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuadmff2-bit/aula-facil.git"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:icons": "tauri icon src-tauri/assets/app-icon.svg",
    "desktop:build": "npm run desktop:icons && tauri build",
    "test": "vitest run",
    "lint": "eslint src/management tests/management",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "lucide-react": "^0.542.0",
    "qrcode": "1.5.4",
    "react": "^19.1.1",

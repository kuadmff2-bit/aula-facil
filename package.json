  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.48.1",
    "vite": "^7.1.3",
    "vitest": "^5.0.0"
  }
